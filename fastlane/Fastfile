# frozen_string_literal: true

default_platform(:ios)

# No analytics phone-home from CI.
opt_out_usage

PROJECT        = "CIPlayground.xcodeproj"
SCHEME         = "CIPlayground"
APP_IDENTIFIER = ENV.fetch("APP_IDENTIFIER", "com.example.ciplayground")
TEST_DEVICE    = ENV.fetch("TEST_DEVICE", "iPhone 17")
OUTPUT_DIR     = "build"

platform :ios do
  before_all do
    # On CI this creates a temporary keychain and sets a few sane timeouts.
    # Without it, `match` has nowhere to install certificates.
    setup_ci if is_ci
  end

  desc "Regenerate CIPlayground.xcodeproj from project.yml"
  lane :generate do
    sh("cd .. && xcodegen generate")
  end

  desc "Run SwiftLint in strict mode (warnings fail the build)"
  lane :lint do
    swiftlint(
      mode: :lint,
      strict: true,
      config_file: ".swiftlint.yml",
      raise_if_swiftlint_error: true
    )
  end

  desc "Build and run unit + UI tests on a simulator"
  lane :test do
    generate
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [TEST_DEVICE],
      code_coverage: true,
      result_bundle: true,
      output_directory: "#{OUTPUT_DIR}/test_output",
      derived_data_path: "#{OUTPUT_DIR}/DerivedData",
      # Simulator builds need no signing; asking for it on CI just fails.
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  desc "Build a signed App Store build and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8"),
      is_key_content_base64: true
    )

    generate

    # Pull the distribution cert + profile out of the private match repo.
    sync_code_signing(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly: is_ci,
      api_key: api_key
    )

    # Build numbers must increase forever, and App Store Connect is the only
    # authority on what has already been used. Deriving it from the server
    # avoids the "two pipelines picked the same number" class of bug.
    build_number = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      initial_build_number: 0
    ) + 1
    UI.important("Building build number #{build_number}")

    profile_name = ENV.fetch("sigh_#{APP_IDENTIFIER}_appstore_profile-name")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: OUTPUT_DIR,
      output_name: "CIPlayground.ipa",
      derived_data_path: "#{OUTPUT_DIR}/DerivedData",
      # The project.yml is the source of truth, so the build number is injected
      # at build time rather than committed back into the repo.
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "DEVELOPMENT_TEAM=#{ENV.fetch('DEVELOPMENT_TEAM')}",
        "CODE_SIGN_STYLE=Manual",
        %(PROVISIONING_PROFILE_SPECIFIER="#{profile_name}")
      ].join(" "),
      export_options: {
        provisioningProfiles: { APP_IDENTIFIER => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      # Don't hold a macOS runner hostage while Apple processes the binary.
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("CHANGELOG", "Automated build from #{git_branch} @ #{last_git_commit[:abbreviated_commit_hash]}")
    )
  end

  error do |lane, exception|
    UI.error("Lane #{lane} failed: #{exception.message}")
  end
end
