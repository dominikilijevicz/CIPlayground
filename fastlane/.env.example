# Copy to fastlane/.env (gitignored) for running lanes locally.
# fastlane loads fastlane/.env automatically.
#
# CI does NOT use this file — it reads GitHub secrets instead.

APP_IDENTIFIER=com.yourname.ciplayground
DEVELOPMENT_TEAM=YOURTEAMID

# Simulator used by the `test` lane.
TEST_DEVICE=iPhone 17

# Needed only by the `beta` lane.
MATCH_GIT_URL=https://github.com/yourname/certificates.git
MATCH_PASSWORD=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
# base64 -i AuthKey_XXXXXXXXXX.p8
APP_STORE_CONNECT_KEY_P8=
