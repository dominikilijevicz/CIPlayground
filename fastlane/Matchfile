# match keeps your signing certificates and provisioning profiles in a
# SEPARATE PRIVATE git repo, encrypted with MATCH_PASSWORD.
#
# This must not be the same repo as the app when the app repo is public.
git_url ENV.fetch("MATCH_GIT_URL", "https://github.com/CHANGE_ME/certificates.git")
storage_mode "git"

type "appstore"
app_identifier [ENV.fetch("APP_IDENTIFIER", "com.example.ciplayground")]

# CI must never be able to create or revoke certificates.
readonly ENV["CI"] == "true"
